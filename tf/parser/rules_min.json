{
  "default": {
    "font_cn": "宋体",
    "font_en": "Times New Roman",
    "size_pt": 12.0,
    "bold": false,
    "italic": false,
    "align": "justify",
    "line_spacing": 1.5,
    "first_line_indent_chars": 2.0,
    "space_before_pt": 0,
    "space_after_pt": 0
  },
  "styles": {
    "cover_title": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 26.0, "bold": true, "align": "center"},
    "cover_meta": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 14.0, "bold": false, "align": "left"},
    "abstract_title": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 16.0, "bold": true, "align": "center"},
    "abstract_body": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 12.0, "align": "justify", "line_spacing": 1.5, "first_line_indent_chars": 2.0},
    "keywords": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 12.0, "bold": true},
    "toc": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 12.0},
    "heading_1": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 16.0, "bold": true, "align": "center"},
    "heading_2": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 14.0, "bold": true},
    "heading_3": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 12.0, "bold": true},
    "heading_4": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 12.0, "bold": true},
    "body": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 12.0, "align": "justify", "line_spacing": 1.5, "first_line_indent_chars": 2.0},
    "caption": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 10.5, "bold": false, "align": "center"},
    "reference_title": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 16.0, "bold": true, "align": "center"},
    "reference": {"font_cn": "宋体", "font_en": "Times New Roman", "size_pt": 10.5, "hanging_indent_chars": 2.0, "align": "justify"},
    "appendix_title": {"font_cn": "黑体", "font_en": "Times New Roman", "size_pt": 16.0, "bold": true, "align": "center"}
  },
  "heading": {
    "levels": 3,
    "numbering": "auto",
    "caption_prefix": {"figure": "图", "table": "表"}
  },
  "image": {
    "max_width_cm": 14.0,
    "alignment": "center",
    "keep_original_ratio": true,
    "anchor": "inline"
  },
  "table": {
    "style": "three_line",
    "header_row": "auto",
    "repeat_header": true
  },
  "formula": {
    "alignment": "center",
    "numbering": "right",
    "number_format": "（{chapter}-{index}）"
  },
  "section": {
    "cover_page_number": "none",
    "frontmatter_numbering": "upperRoman",
    "mainmatter_start": 1
  },
  "page": {
    "size": "A4",
    "margins_cm": {"top": 2.54, "bottom": 2.54, "left": 3.0, "right": 2.5}
  },
  "classify": {
    "llm_fallback": true,
    "llm_model": "",
    "llm_batch_size": 30,
    "low_confidence_threshold": 0.70
  }
}